<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#FFFFFF">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:padding="32dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Donor Registration"
            android:textColor="#9E1B32"
            android:textSize="26sp"
            android:textStyle="bold"
            android:layout_marginBottom="8dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Fill your details to become a donor"
            android:textColor="#555555"
            android:textSize="14sp"
            android:layout_marginBottom="28dp" />

        <EditText
            android:id="@+id/etDonorName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Full Name"
            android:inputType="textPersonName"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/edit_text" />

        <EditText
            android:id="@+id/etDonorPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Phone Number"
            android:inputType="phone"
            android:maxLength="10"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/edit_text" />

        <Spinner
            android:id="@+id/spinnerBloodGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="14dp"
            android:layout_marginBottom="16dp"
            android:background="@android:drawable/edit_text" />

        <EditText
            android:id="@+id/etDonorArea"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="Area / Locality"
            android:inputType="textPostalAddress"
            android:padding="14dp"
            android:layout_marginBottom="28dp"
            android:background="@android:drawable/edit_text" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSaveDonor"
            android:layout_width="match_parent"
            android:layout_height="55dp"
            android:text="Save and Continue"
            android:textSize="16sp"
            android:textColor="#FFFFFF"
            app:backgroundTint="#9E1B32"
            app:cornerRadius="8dp" />

    </LinearLayout>

</ScrollView>