<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:gravity="center"
    android:padding="24dp"
    android:background="#FFFFFF">

    <ImageView
        android:layout_width="120dp"
        android:layout_height="120dp"
        android:src="@drawable/logo"
        android:layout_marginBottom="12dp"
        android:contentDescription="App Logo" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Blood Donor Finder"
        android:textColor="#9E1B32"
        android:textSize="26sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Save a life, donate blood"
        android:textColor="#555555"
        android:textSize="14sp"
        android:layout_marginBottom="48dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnDonateBlood"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Donate Blood"
        android:textSize="18sp"
        android:textColor="#FFFFFF"
        app:backgroundTint="#9E1B32"
        app:cornerRadius="8dp"
        android:layout_marginBottom="16dp" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnFindBlood"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="Find Blood"
        android:textSize="18sp"
        android:textColor="#9E1B32"
        app:backgroundTint="#FFFFFF"
        app:strokeColor="#9E1B32"
        app:strokeWidth="2dp"
        app:cornerRadius="8dp" />

</LinearLayout>